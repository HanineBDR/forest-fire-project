# IN9AD Backend Environment Variables
PORT=8000
CORS_ORIGINS=*

# Optional: NASA FIRMS Map Key (if you have a free personal key from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# If left blank, IN9AD automatically uses the verified reference satellite cache for Northern Algeria.
FIRMS_MAP_KEY=

# Security & Authentication Configuration
JWT_SECRET=in9ad-algeria-wildfire-defense-key-2026-sec-token
RATE_LIMIT_PER_MINUTE=100
